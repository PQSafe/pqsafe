[Unit]
Description=PQSafe API Reference Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pqsafe
Group=pqsafe
WorkingDirectory=/opt/pqsafe/api-reference
EnvironmentFile=/etc/pqsafe/api.env
ExecStart=/opt/pqsafe/api-reference/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --log-level info --access-log
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/pqsafe/api-reference

[Install]
WantedBy=multi-user.target
