# PQSafe Minds adapter production env
# Load these as platform secrets, not as a committed .env file.

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Required in production. All Minds write calls must send:
#   Authorization: Bearer <PQSAFE_API_KEY>
PQSAFE_API_KEY=replace-with-strong-random-token

# Demo Day route does not move funds; keep rail calls mocked unless another
# route on the same deployment intentionally needs real Airwallex settlement.
PQSAFE_MOCK_MODE=true
AIRWALLEX_MODE=sandbox
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=

# Use the final Minds Tool web origin(s) once Raymond confirms them.
# Pydantic reads this JSON list from the environment.
CORS_ORIGINS=["https://minds.com","https://build.minds.com","http://localhost:3000"]

# Optional but recommended for stable adapter identity across restarts.
# Generate after installing dependencies:
#   python - <<'PY'
#   from app.crypto.envelope import generate_keypair
#   pk, sk = generate_keypair()
#   print("MINDS_ADAPTER_PUBLIC_KEY_HEX=" + pk.hex())
#   print("MINDS_ADAPTER_SECRET_KEY_HEX=" + sk.hex())
#   PY
MINDS_ADAPTER_PUBLIC_KEY_HEX=
MINDS_ADAPTER_SECRET_KEY_HEX=
